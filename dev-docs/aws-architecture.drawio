<mxfile host="app.diagrams.net" type="device"><diagram id="clay-aws" name="AWS architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c11" value="&lt;b&gt;Clay Agent-Eval Sandbox: AWS architecture&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Team 43, Renaissance Philanthropy x Clay hackathon. Region us-west-2. Agents are scored on geospatial tasks through MCP tools; every run is traced, scored and compared.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="c12" value="Developer laptop / CI" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;strokeColor=#879196;fillColor=#F7F9FA;dashed=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="320" height="760" as="geometry"/></mxCell><mxCell id="c13" value="Evaluator" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="60" y="125" width="44" height="44" as="geometry"/></mxCell><mxCell id="c14" value="AWS CDK" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloud_development_kit;" vertex="1" parent="1"><mxGeometry x="255" y="150" width="44" height="44" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;clay-sandbox CLI&lt;/b&gt; (WS5)&lt;br&gt;run · eval · estimate · rescore ·&lt;br&gt;validate-evaluator · report" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#545B64;fillColor=#FFFFFF;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="280" height="66" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Service + executor&lt;/b&gt; (WS5)&lt;br&gt;eval spec → run plan · infra retries ·&lt;br&gt;eval $ cap · pre-flight estimate (WS1)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#545B64;fillColor=#FFFFFF;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="280" height="66" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Local live&lt;/b&gt;: same run worker on the laptop,&lt;br&gt;calling Bedrock directly (③). &lt;b&gt;Offline&lt;/b&gt;: replay,&lt;br&gt;re-score, stats and CI need no AWS." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#545B64;fillColor=#F7F9FA;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="280" height="66" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Scoring + statistics&lt;/b&gt; (WS4)&lt;br&gt;workflow@1 · output.t1–t5 · llm_process&lt;br&gt;Wilson · cluster bootstrap · sign-flip · Holm&lt;br&gt;planted-trace validation (J6)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#545B64;fillColor=#FFFFFF;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="280" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Run store&lt;/b&gt; (WS3)&lt;br&gt;runs/&amp;lt;id&amp;gt;/ trace.jsonl · manifest.json ·&lt;br&gt;assessments · report.md/html · DuckDB queries&lt;br&gt;mirrored to S3 (②)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#545B64;fillColor=#FFFFFF;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="585" width="280" height="80" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Docker image&lt;/b&gt;&lt;br&gt;CLI + worker + pinned MCP servers&lt;br&gt;(pushed to ECR, ⑬)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#ED7100;fillColor=#FFF7EF;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="685" width="280" height="60" as="geometry"/></mxCell><mxCell id="c21" value="scripts/refresh_prices.py → Price List API (⑭)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#545B64;fillColor=#F7F9FA;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="280" height="34" as="geometry"/></mxCell><mxCell id="c22" value="AWS Cloud" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="370" y="90" width="1170" height="590" as="geometry"/></mxCell><mxCell id="c23" value="Region us-west-2 · hackathon sandbox account" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;dashed=1;" vertex="1" parent="1"><mxGeometry x="390" y="125" width="1130" height="540" as="geometry"/></mxCell><mxCell id="c24" value="AWS CloudFormation (CDK stack)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="430" y="168" width="48" height="48" as="geometry"/></mxCell><mxCell id="c25" value="IAM task + execution roles (least privilege)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="640" y="168" width="48" height="48" as="geometry"/></mxCell><mxCell id="c26" value="AWS Price List API" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cost_explorer;" vertex="1" parent="1"><mxGeometry x="850" y="168" width="48" height="48" as="geometry"/></mxCell><mxCell id="c27" value="VPC · public subnets, no NAT gateway (cost)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#8C4FFF;dashed=0;" vertex="1" parent="1"><mxGeometry x="410" y="240" width="610" height="410" as="geometry"/></mxCell><mxCell id="c28" value="Amazon ECS cluster" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecs;" vertex="1" parent="1"><mxGeometry x="425" y="320" width="52" height="52" as="geometry"/></mxCell><mxCell id="c29" value="AWS Fargate task&lt;br&gt;1 vCPU / 2 GB" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="425" y="450" width="52" height="52" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Run worker container&lt;/b&gt;&lt;br&gt;clay-sandbox worker --request s3://…/requests/&amp;lt;run_id&amp;gt;.json&lt;br&gt;&lt;br&gt;• &lt;b&gt;Harness&lt;/b&gt; (WS1): Strands or Converse loop · budget + loop guards&lt;br&gt;• &lt;b&gt;MCP tool set T1 / T0&lt;/b&gt; (WS2), stdio subprocesses:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;roda · stac · osm · clay_embeddings&lt;br&gt;• &lt;b&gt;Tracers&lt;/b&gt; (WS3): JSONL · OpenTelemetry · tee&lt;br&gt;• &lt;b&gt;Evaluators&lt;/b&gt; (WS4): workflow · output · LLM judge&lt;br&gt;• &lt;b&gt;Task library&lt;/b&gt; (WS2): T1–T5 × 6 AOIs, versioned references&lt;br&gt;&lt;br&gt;&lt;i&gt;Fargate executor (WS1): request → ecs:RunTask → runs/&amp;lt;id&amp;gt;/status.json;&lt;br&gt;infra errors retried, then excluded from statistics&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#ED7100;fillColor=#FFF7EF;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="520" y="280" width="470" height="300" as="geometry"/></mxCell><mxCell id="c31" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1060" y="285" width="56" height="56" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt; (Converse API)&lt;br&gt;Agents: Nova Lite (dev) · Nova Pro (baseline) ·&lt;br&gt;Claude Sonnet 4.6 · Judge: Llama 3.3 70B · Summary: Nova Lite" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#01A88D;fillColor=#E6F6F3;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1125" y="280" width="380" height="66" as="geometry"/></mxCell><mxCell id="c33" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1060" y="370" width="56" height="56" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Amazon S3&lt;/b&gt; sandbox bucket&lt;br&gt;runs/ · evals/ · requests/ · data/embeddings/&lt;br&gt;block public · SSE-S3 · versioned" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;spacingRight=6;verticalAlign=middle;strokeColor=#7AA116;fillColor=#F2F6E8;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1125" y="365" width="380" height="66" as="geometry"/></mxCell><mxCell id="c35" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="1060" y="455" width="56" height="56" as="geometr