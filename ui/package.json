{
  "name": "claysandbox-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/model.test.ts && vite build --ssr tests/render.tsx --outDir node_modules/.cache/ui-tests && node node_modules/.cache/ui-tests/render.js",
    "test:browser": "node tests/browser.cjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
